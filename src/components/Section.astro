---
interface Props {
  text: string;
  href: string;
}

const { text, href } = Astro.props;
---

<section id={href} class="py-24">
  <div class="mx-auto max-w-3xl px-5">
    <div class="mx-auto mb-6 h-px w-16 bg-primary/40"></div>
    <h2
      class="mb-16 text-center font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl"
    >
      {text}
    </h2>
    <slot />
  </div>
</section>
