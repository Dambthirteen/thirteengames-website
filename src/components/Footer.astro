---
import type { SiteConfig } from "@types";
import { SITE_CONTENT } from "@config";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
const email = SITE_CONTENT.hero.email;
const projects = SITE_CONTENT.projects;
---

<footer class="w-full border-t border-neutral/20 px-5 pt-14 pb-8 text-white">
  <div class="mx-auto max-w-3xl">

    {/* Grid mit 3 Spalten */}
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-3 mb-12">

      {/* Spalte 1: Brand */}
      <div>
        <h3 class="mb-4 font-serif text-lg font-bold text-white">Thirteen Games</h3>
        <p class="text-sm text-neutral/60 leading-relaxed">
          Independent game studio based in Cologne, Germany.
        </p>
      </div>

      {/* Spalte 2: Projects */}
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral/40">Projects</h3>
        <ul class="space-y-2">
          {projects.map((project) => (
            <li>
              <a
                href={`/projects/${project.slug}`}
                class="text-sm text-neutral/60 transition hover:text-white"
              >
                {project.name}
              </a>
            </li>
          ))}
          <li>
            <a
              href="/projects/gamejams"
              class="text-sm text-neutral/60 transition hover:text-white"
            >
              Game Jams
            </a>
          </li>
        </ul>
      </div>

      {/* Spalte 3: Connect */}
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral/40">Connect</h3>
        <ul class="space-y-2">
          {socialLinks.map(({ text, href }) => (
            <li>
              <a
                href={href}
                target="_blank"
                class="text-sm text-neutral/60 transition hover:text-white"
              >
                {text}
              </a>
            </li>
          ))}
          <li>
            <a
              href={`mailto:${email}`}
              class="text-sm text-neutral/60 transition hover:text-white"
            >
              Email
            </a>
          </li>
        </ul>
      </div>

    </div>

    {/* Bottom Bar */}
    <div class="border-t border-neutral/10 pt-6 text-center">
      <p class="text-xs text-neutral/40">
        {author} © {currentYear}. <span>Designed & Developed by</span> Dani Lipke
      </p>
    </div>

  </div>
</footer>