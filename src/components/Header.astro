---
import Menu from "@icons/Menu.astro";
import type { HeaderProps } from "@types";

type Props = HeaderProps;

const { navLinks } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 z-50 flex w-full items-center justify-between px-6 py-4 md:px-10"
  id="site-header"
>
  <a href="/" class="flex items-center gap-3 transition hover:opacity-80">
    <img
      src="/logo-thirteengames-justtext-notsquared.png"
      alt="Thirteen Games"
      class="h-12 w-auto"
    />
  </a>

  <button
    type="button"
    id="menu-button"
    class="px-1.5 text-neutral sm:hidden"
    aria-expanded="false"
    aria-controls="main-menu"
  >
    <Menu />
  </button>

  <nav
    class="absolute top-20 right-5 hidden rounded-xl border border-neutral/20 bg-black/95 px-4 py-5 text-neutral backdrop-blur-md sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0 sm:backdrop-blur-none"
    id="main-menu"
  >
    <ul class="gap-2 sm:flex sm:items-center">
      {
        navLinks.map((link) => {
          const isActive = currentPath === link.href ||
            (link.children && link.children.some(child => currentPath === child.href));
          const isExternal = link.href.startsWith('http');
          return (
            <li class="relative group">
              <a
                class={`nav-item relative block p-2 text-sm font-medium transition-all duration-300 hover:text-white ${
                  isActive
                    ? 'text-white after:absolute after:bottom-0 after:left-2/4 after:h-2 after:w-1 after:-translate-x-2/4 after:text-primary after:opacity-100 after:content-["•"]'
                    : 'text-neutral/80 after:absolute after:bottom-0 after:left-2/4 after:h-2 after:w-1 after:-translate-x-2/4 after:text-primary after:opacity-0 after:content-["•"] hover:after:opacity-100'
                }`}
                href={link.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
              >
                {link.text}
                {link.children && (
                  <svg class="inline-block ml-1 w-3 h-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="2 4 6 8 10 4" />
                  </svg>
                )}
              </a>
              {link.children && (
                <ul class="dropdown-menu hidden sm:block sm:invisible sm:opacity-0 sm:absolute sm:top-full sm:right-0 sm:mt-1 sm:min-w-48 sm:rounded-lg sm:border sm:border-neutral/20 sm:bg-black/95 sm:py-2 sm:shadow-xl sm:backdrop-blur-md sm:transition-all sm:duration-200 sm:group-hover:visible sm:group-hover:opacity-100 pl-4 sm:pl-0 sm:pointer-events-none sm:group-hover:pointer-events-auto">
                  {link.children.map((child) => {
                    const isChildActive = currentPath === child.href;
                    return (
                      <li>
                        <a
                          href={child.href}
                          class={`block px-4 py-2 text-sm transition-colors hover:text-white hover:bg-neutral/10 ${
                            isChildActive ? 'text-white' : 'text-neutral/70'
                          }`}
                        >
                          {child.text}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      header?.classList.add('header-scrolled');
    } else {
      header?.classList.remove('header-scrolled');
    }
  }, { passive: true });

  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu > ul > li > a");

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    const isHidden = menu?.classList.contains("hidden");
    button?.setAttribute("aria-expanded", `${!isHidden}`);
  };

  button?.addEventListener("click", toggleMenu);

  navItems.forEach((item) => {
    const parent = item.closest('li');
    const hasChildren = parent?.querySelector('.dropdown-menu');
    if (!hasChildren) {
      item.addEventListener("click", toggleMenu);
    }
  });

  document.querySelectorAll('.dropdown-menu a').forEach((link) => {
    link.addEventListener('click', toggleMenu);
  });
</script>

<style>
  #site-header {
    transition: background-color 0.4s ease, backdrop-filter 0.4s ease, border-color 0.4s ease;
    border-bottom: 1px solid transparent;
  }

  #site-header.header-scrolled {
    background-color: rgba(14, 13, 12, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: rgba(253, 245, 219, 0.06);
  }
</style>
