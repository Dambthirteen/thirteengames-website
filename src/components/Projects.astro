---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
    {
      projects.map(({ name, category, info, image, slug }, index) => {
        return (
          <a
            href={`/projects/${slug}`}
            class="project-card block"
            style={`transition-delay: ${index * 150}ms;`}
            data-index={index}
          >
            <div
              class="tilt-card group relative overflow-hidden rounded-lg border border-neutral/20 bg-[#1c232d]/85 transition-all duration-300 ease-out"
            >
              <div class="relative h-72 w-full overflow-hidden sm:h-80">
                <Image
                  class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-110"
                  src={image}
                  alt={name}
                  width="736"
                  height="483"
                />

                <div class="grain-overlay absolute inset-0 pointer-events-none opacity-30 mix-blend-overlay" />

                <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/0 transition-all duration-400 group-hover:bg-black/95">
                  <p class="mx-6 text-center text-sm leading-relaxed text-neutral opacity-0 translate-y-4 transition-all duration-300 delay-100 group-hover:opacity-100 group-hover:translate-y-0">
                    {info}
                  </p>
                  <div class="mt-4 opacity-0 translate-y-4 transition-all duration-300 delay-200 group-hover:opacity-100 group-hover:translate-y-0">
                    <span class="rounded-full border border-neutral/40 px-4 py-2 text-xs text-white transition hover:bg-primary hover:border-primary">
                      View Project
                    </span>
                  </div>
                </div>
              </div>

              <div class="relative px-6 py-7 border-t border-neutral/10">
                <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent"></div>
                <div class="relative">
                  <p class="overline mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">
                    {category}
                  </p>
                  <h3 class="font-serif text-2xl font-medium text-white tracking-tight">
                    {name}
                  </h3>
                </div>
              </div>
            </div>
          </a>
        );
      })
    }
  </div>
</Section>

<style>
  .project-card {
    opacity: 0;
    transform: translateY(60px);
  }

  .project-card.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.9s ease-out, transform 0.9s ease-out;
  }

  .tilt-card {
    transform-style: preserve-3d;
    will-change: transform;
    position: relative;
    background: linear-gradient(160deg, rgba(28, 35, 45, 0.9) 0%, rgba(14, 13, 12, 0.95) 100%);
    box-shadow: 
      0 2px 20px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(253, 245, 219, 0.05);
  }

  .tilt-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 0.6rem;
    background: linear-gradient(
      var(--glow-angle, 0deg),
      #951810,
      transparent 40%,
      transparent 60%,
      #951810
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: -1;
    animation: glow-spin 4s linear infinite;
  }

  .tilt-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    border: 1px solid rgba(149, 24, 16, 0.15);
    transition: border-color 0.3s ease;
    pointer-events: none;
  }

  .tilt-card:hover::before {
    opacity: 1;
  }

  .tilt-card:hover::after {
    border-color: rgba(149, 24, 16, 0.4);
  }

  .tilt-card:hover {
    box-shadow: 
      0 20px 50px rgba(149, 24, 16, 0.25),
      0 4px 20px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(253, 245, 219, 0.08);
  }

  @keyframes glow-spin {
    0% { --glow-angle: 0deg; }
    100% { --glow-angle: 360deg; }
  }

  @property --glow-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .grain-overlay {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 128px 128px;
  }
</style>

<script>
  const cards = document.querySelectorAll('.project-card');

  const fadeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          fadeObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  cards.forEach((card) => fadeObserver.observe(card));

  const tiltCards = document.querySelectorAll('.tilt-card');

  tiltCards.forEach((card) => {
    const el = card as HTMLElement;

    el.addEventListener('mousemove', (e) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;
      const pullX = ((x - centerX) / centerX) * 8;
      const pullY = ((y - centerY) / centerY) * 8;

      el.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateX(${pullX}px) translateY(${pullY}px) scale(1.03)`;
    });

    el.addEventListener('mouseleave', () => {
      el.style.transform = 'rotateX(0deg) rotateY(0deg) translateX(0px) translateY(0px) scale(1)';
    });
  });
</script>