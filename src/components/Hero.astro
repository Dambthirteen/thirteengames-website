---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary } = Astro.props;
---

<section class="relative text-center" id="hero">

  <div class="relative h-[420px] md:h-[520px] overflow-hidden w-screen left-1/2 -translate-x-1/2">
    <img
      src="/banner-backround.jpg"
      alt=""
      class="absolute inset-0 w-full h-[160%] object-cover will-change-transform"
      id="parallax-banner"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/50 to-black"></div>

    {/* Alles zentriert im Banner */}
    <div class="absolute inset-0 flex flex-col items-center justify-center px-6">
      <img
        src="/logo-thirteengames.png"
        alt="Thirteen Games Logo"
        class="h-52 md:h-72 w-auto drop-shadow-2xl mb-6"
      />
      <h1 class="glitch-wrapper font-serif text-4xl font-bold text-white sm:text-6xl md:text-7xl">
        <span id="typewriter-name" class="glitch-text inline-block" data-text=""></span>
        <span class="typewriter-cursor">|</span>
      </h1>
      <p class="mt-3 font-serif text-lg font-bold text-primary sm:text-xl md:text-2xl tracking-wider">
        <span id="typewriter-specialty" class="inline-block"></span>
      </p>
      <p class="mt-4 text-sm text-neutral/60">
        {summary}
      </p>
    </div>
  </div>

</section>

<style>
  .typewriter-cursor {
    animation: blink 0.7s step-end infinite;
    font-weight: 100;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .glitch-text {
    position: relative;
  }

  .glitch-text::before,
  .glitch-text::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  .glitch-text.glitch-active::before {
    color: #951810;
    visibility: visible;
    animation: glitch-1 4s infinite linear;
    clip-path: inset(0 0 65% 0);
  }

  .glitch-text.glitch-active::after {
    color: #FDF5DB;
    visibility: visible;
    animation: glitch-2 4s infinite linear;
    clip-path: inset(65% 0 0 0);
  }

  .glitch-wrapper:hover .glitch-text.glitch-active::before,
  .glitch-wrapper:hover .glitch-text.glitch-active::after {
    opacity: 0.8;
  }

  @keyframes glitch-1 {
    0%, 92% { transform: translate(0); opacity: 0; }
    93% { transform: translate(-4px, -2px); opacity: 0.8; }
    94% { transform: translate(4px, 1px); opacity: 0.7; }
    95% { transform: translate(-2px, 3px); opacity: 0.8; }
    96% { transform: translate(3px, -1px); opacity: 0.6; }
    97%, 100% { transform: translate(0); opacity: 0; }
  }

  @keyframes glitch-2 {
    0%, 94% { transform: translate(0); opacity: 0; }
    95% { transform: translate(3px, 2px); opacity: 0.8; }
    96% { transform: translate(-3px, -1px); opacity: 0.7; }
    97% { transform: translate(2px, -2px); opacity: 0.6; }
    98%, 100% { transform: translate(0); opacity: 0; }
  }
</style>

<script define:vars={{ name, specialty }}>
  function typeWriter(element, text, speed, callback) {
    let i = 0;
    function type() {
      if (i < text.length) {
        element.textContent += text.charAt(i);
        element.setAttribute('data-text', element.textContent);
        i++;
        setTimeout(type, speed);
      } else if (callback) {
        callback();
      }
    }
    type();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const nameEl = document.getElementById('typewriter-name');
    const specialtyEl = document.getElementById('typewriter-specialty');
    const cursor = document.querySelector('.typewriter-cursor');

    if (nameEl && specialtyEl) {
      typeWriter(nameEl, name, 80, () => {
        if (cursor) cursor.remove();
        nameEl.classList.add('glitch-active');
        typeWriter(specialtyEl, specialty, 60);
      });
    }
  });
</script>

<script>
  const banner = document.getElementById('parallax-banner');
  window.addEventListener('scroll', () => {
    if (!banner) return;
    const scrollY = window.scrollY;
    banner.style.transform = `translateY(${scrollY * 0.6}px)`;
  }, { passive: true });
</script>