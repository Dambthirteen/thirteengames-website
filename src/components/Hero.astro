---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary } = Astro.props;
---

<section class="relative text-center" id="hero">

  <div class="relative h-[420px] md:h-[520px] overflow-hidden w-screen left-1/2 -translate-x-1/2">
    <img
      src="/banner-backround.jpg"
      alt=""
      class="absolute inset-0 w-full h-[160%] object-cover will-change-transform"
      id="parallax-banner"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-transparent to-black"></div>

    {/* Alles zentriert im Banner */}
    <div class="absolute inset-0 flex flex-col items-center justify-center px-6">
      <img
        src="/logo-thirteengames.png"
        alt="Thirteen Games Logo"
        class="h-64 md:h-80 w-auto drop-shadow-2xl mb-6"
      />
      <p class="glitch-wrapper font-serif text-2xl font-bold text-black sm:text-3xl md:text-4xl tracking-wider">
      <span id="typewriter-specialty" class="glitch-text inline-block" data-text=""></span>
      <span class="typewriter-cursor">|</span>
      </p>
      <p class="mt-4 text-sm text-neutral/60">
        {summary}
      </p>
    </div>
  </div>

</section>

<style>
  .typewriter-cursor {
    animation: blink 0.7s step-end infinite;
    font-weight: 100;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .glitch-text {
    position: relative;
  }

  .glitch-text::before,
  .glitch-text::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  .glitch-text.glitch-active::before {
    color: #ff1a1a;
    text-shadow: 2px 0 #951810;
    visibility: visible;
    animation: glitch-strong-1 3s infinite linear;
    clip-path: inset(0 0 50% 0);
  }

  .glitch-text.glitch-active::after {
    color: #FDF5DB;
    text-shadow: -2px 0 #3a0a07;
    visibility: visible;
    animation: glitch-strong-2 3s infinite linear;
    clip-path: inset(50% 0 0 0);
  }

  .glitch-wrapper:hover .glitch-text.glitch-active::before,
  .glitch-wrapper:hover .glitch-text.glitch-active::after {
    animation-duration: 0.8s;
  }

  @keyframes glitch-strong-1 {
    0%, 82% { transform: translate(0); opacity: 0; }
    83% { transform: translate(-6px, -3px) skewX(-2deg); opacity: 0.9; }
    84% { transform: translate(8px, 2px) skewX(1deg); opacity: 0.8; }
    85% { transform: translate(-4px, -1px); opacity: 0.9; }
    86% { transform: translate(6px, 3px) skewX(-1deg); opacity: 0.7; }
    87% { transform: translate(-8px, 1px) skewX(2deg); opacity: 0.9; }
    88% { transform: translate(3px, -2px); opacity: 0.8; }
    89%, 100% { transform: translate(0); opacity: 0; }
  }

  @keyframes glitch-strong-2 {
    0%, 85% { transform: translate(0); opacity: 0; }
    86% { transform: translate(7px, 2px) skewX(2deg); opacity: 0.9; }
    87% { transform: translate(-5px, -3px) skewX(-1deg); opacity: 0.8; }
    88% { transform: translate(6px, -1px); opacity: 0.9; }
    89% { transform: translate(-7px, 2px) skewX(1deg); opacity: 0.7; }
    90% { transform: translate(4px, 3px) skewX(-2deg); opacity: 0.9; }
    91%, 100% { transform: translate(0); opacity: 0; }
  }
</style>

<script define:vars={{ specialty }}>
  function typeWriter(element, text, speed, callback) {
    let i = 0;
    function type() {
      if (i < text.length) {
        element.textContent += text.charAt(i);
        element.setAttribute('data-text', element.textContent);
        i++;
        setTimeout(type, speed);
      } else if (callback) {
        callback();
      }
    }
    type();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const specialtyEl = document.getElementById('typewriter-specialty');
    const cursor = document.querySelector('.typewriter-cursor');

    if (specialtyEl) {
      typeWriter(specialtyEl, specialty, 60, () => {
        if (cursor) cursor.remove();
        specialtyEl.classList.add('glitch-active');
      });
    }
  });
</script>

<script>
  const banner = document.getElementById('parallax-banner');
  window.addEventListener('scroll', () => {
    if (!banner) return;
    const scrollY = window.scrollY;
    banner.style.transform = `translateY(${scrollY * 0.6}px)`;
  }, { passive: true });
</script>