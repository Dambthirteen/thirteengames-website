---
import Layout from "@layouts/Layout.astro";
import "../../styles/global.css";
---

<Layout
  fullscreen
  pageTitle="You Should Choose — Thirteen Games"
  pageDescription="You Should Choose — an upcoming indie title by Thirteen Games. Currently in early development."
>

  <!-- ===== HERO ===== -->
  <section class="ysc-panel" id="ysc-hero">
    <div class="ysc-bg-wrap">
      <img src="/Comingsoon-banner.png" alt="You Should Choose" class="ysc-bg" />
    </div>
    <div class="ysc-sweep"></div>
    <div class="ysc-grad ysc-grad--left"></div>
    <div class="ysc-content ysc-content--left">
      <div class="ysc-inner">
        <span class="ysc-eyebrow">Thirteen Games — Game Development</span>
        <h1 class="ysc-title">You Should<br>Choose</h1>
        <p class="ysc-tagline">An upcoming title about meaningful choices.<br>Currently in early development.</p>
        <div class="ysc-actions">
          <span class="btn-soon btn-soon--primary">Coming Soon</span>
          <span class="btn-soon btn-soon--outline">Wishlist Coming Soon</span>
        </div>
      </div>
    </div>
    <div class="ysc-scroll-hint">
      <div class="ysc-scroll-line"></div>
    </div>
  </section>

  <!-- ===== 01 — THE STORY ===== -->
  <section class="ysc-panel" id="ysc-story">
    <div class="ysc-bg-wrap">
      <img src="/Comingsoon-banner.png" alt="The Story" class="ysc-bg" style="object-position: 60% center;" />
    </div>
    <div class="ysc-sweep"></div>
    <div class="ysc-grad ysc-grad--left"></div>
    <div class="ysc-content ysc-content--left">
      <div class="ysc-inner">
        <span class="ysc-eyebrow">01 — The Story</span>
        <h2 class="ysc-title">Every Choice<br>Matters</h2>
        <p class="ysc-tagline">
          You Should Choose places the player at the center of a world where decisions
          carry real weight. There are no right answers — only consequences.
          More details about the world and narrative will be revealed as development progresses.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 02 — GAMEPLAY ===== -->
  <section class="ysc-panel ysc-panel--right" id="ysc-gameplay">
    <div class="ysc-bg-wrap">
      <img src="/Comingsoon-banner.png" alt="Gameplay" class="ysc-bg" style="object-position: 40% center;" />
    </div>
    <div class="ysc-sweep"></div>
    <div class="ysc-grad ysc-grad--right"></div>
    <div class="ysc-content ysc-content--right">
      <div class="ysc-inner">
        <span class="ysc-eyebrow">02 — Gameplay</span>
        <h2 class="ysc-title">Systems That<br>React</h2>
        <p class="ysc-tagline">
          Built around interlocking systems where the player's choices feed back
          into the world. Gameplay details and a first look are coming soon.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 03 — IN DEVELOPMENT ===== -->
  <section class="ysc-panel" id="ysc-dev">
    <div class="ysc-bg-wrap">
      <img src="/Comingsoon-banner.png" alt="In Development" class="ysc-bg" style="object-position: 50% 30%;" />
    </div>
    <div class="ysc-sweep"></div>
    <div class="ysc-grad ysc-grad--left"></div>
    <div class="ysc-content ysc-content--left">
      <div class="ysc-inner">
        <span class="ysc-eyebrow">03 — In Development</span>
        <h2 class="ysc-title">Built at<br>Thirteen Games</h2>
        <p class="ysc-tagline">
          Developed solo in Unity/C# at Thirteen Games, based in Cologne, Germany.
          The project is currently in early development — follow for updates as the game takes shape.
        </p>
        <div class="ysc-actions">
          <a href="https://www.youtube.com/@Thirteen-games" target="_blank" class="btn-soon btn-soon--outline" style="cursor: pointer; opacity: 1; pointer-events: all;">
            Follow on YouTube
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 04 — STEAM ===== -->
  <section class="ysc-panel ysc-panel--right" id="ysc-steam">
    <div class="ysc-bg-wrap">
      <img src="/Comingsoon-banner.png" alt="Steam" class="ysc-bg" style="object-position: 55% center;" />
    </div>
    <div class="ysc-sweep"></div>
    <div class="ysc-grad ysc-grad--right"></div>
    <div class="ysc-content ysc-content--right">
      <div class="ysc-inner">
        <span class="ysc-eyebrow">04 — Steam</span>
        <h2 class="ysc-title">Wishlist<br>Coming Soon</h2>
        <p class="ysc-tagline">
          You Should Choose is heading to Steam. The store page is not live yet —
          wishlist support will be announced once the page goes up.
        </p>
        <div class="ysc-actions">
          <a href="/projects/you-should-choose" class="btn-soon btn-soon--primary" style="cursor: pointer; opacity: 1; pointer-events: all; text-decoration: none;">Wishlist Coming Soon</a>
          <a href="/" class="btn-soon btn-soon--outline" style="cursor: pointer; opacity: 1; pointer-events: all; text-decoration: none;">
            ← All Projects
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ===== PANEL BASE ===== */
  .ysc-panel {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  /* ===== PARALLAX BG ===== */
  .ysc-bg-wrap {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .ysc-bg {
    position: absolute;
    top: -10%;
    left: 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center;
    transition: transform 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ysc-panel:hover .ysc-bg {
    transform: scale(1.04);
  }

  /* ===== GRADIENTS ===== */
  .ysc-grad {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ysc-grad--left {
    background:
      linear-gradient(to right, rgba(14,13,12,0.90) 0%, rgba(14,13,12,0.55) 48%, transparent 78%),
      linear-gradient(to top, rgba(14,13,12,0.97) 0%, rgba(14,13,12,0.6) 28%, rgba(14,13,12,0.1) 65%, transparent 100%);
  }

  .ysc-grad--right {
    background:
      linear-gradient(to left, rgba(14,13,12,0.90) 0%, rgba(14,13,12,0.55) 48%, transparent 78%),
      linear-gradient(to top, rgba(14,13,12,0.97) 0%, rgba(14,13,12,0.6) 28%, rgba(14,13,12,0.1) 65%, transparent 100%);
  }

  /* ===== CONTENT BLOCKS ===== */
  .ysc-content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding: 0 5rem 7rem;
    display: flex;
  }

  .ysc-content--left {
    justify-content: flex-start;
  }

  .ysc-content--right {
    justify-content: flex-end;
  }

  @media (max-width: 768px) {
    .ysc-content {
      padding: 0 1.75rem 4.5rem;
      justify-content: flex-start !important;
    }
  }

  /* ===== INNER TEXT BLOCK ===== */
  .ysc-inner {
    position: relative;
    isolation: isolate;
    max-width: 680px;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1.1s ease, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ysc-inner::before {
    content: '';
    position: absolute;
    left: -2.5rem;
    right: -1.5rem;
    top: -1.5rem;
    bottom: -1.5rem;
    background: radial-gradient(ellipse at 25% 60%, rgba(14,13,12,0.65) 30%, transparent 75%);
    z-index: -1;
    pointer-events: none;
  }

  .ysc-panel--right .ysc-inner {
    transform: translateX(48px);
  }

  .ysc-inner.is-visible {
    opacity: 1;
    transform: translate(0, 0) !important;
  }

  /* ===== TYPOGRAPHY ===== */
  .ysc-eyebrow {
    display: block;
    font-family: var(--font-display, 'Boldonse', serif);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c42218;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 14px rgba(0,0,0,0.9);
  }

  .ysc-title {
    font-family: var(--font-display, 'Boldonse', serif);
    font-size: clamp(3.2rem, 7.5vw, 7rem);
    font-weight: 400;
    color: #ffffff;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin-bottom: 1.75rem;
    text-shadow: 0 4px 28px rgba(0,0,0,0.95), 0 2px 8px rgba(0,0,0,0.8);
  }

  .ysc-tagline {
    font-size: 1.15rem;
    line-height: 1.75;
    color: rgba(253, 245, 219, 0.72);
    max-width: 500px;
    margin-bottom: 3rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.9);
  }

  .ysc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* ===== COMING SOON BUTTONS ===== */
  .btn-soon {
    display: inline-block;
    border-radius: 9999px;
    padding: 0.875rem 2.5rem;
    font-size: 1rem;
    font-weight: 500;
    cursor: not-allowed;
    opacity: 0.55;
    user-select: none;
    pointer-events: none;
    transition: none;
  }

  .btn-soon--primary {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .btn-soon--outline {
    border: 1px solid rgba(253, 245, 219, 0.3);
    color: #ffffff;
  }

  /* ===== SWEEP LINE ===== */
  .ysc-sweep {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, transparent 0%, #951810 20%, #ff3322 50%, #951810 80%, transparent 100%);
    z-index: 20;
    pointer-events: none;
    transform: translateX(-100%);
    opacity: 0;
  }

  @keyframes ysc-sweep {
    0%   { transform: translateX(-100%); opacity: 0; }
    8%   { opacity: 1; }
    80%  { opacity: 0.9; }
    100% { transform: translateX(100%); opacity: 0; }
  }

  .ysc-panel.in-view .ysc-sweep {
    animation: ysc-sweep 1.3s cubic-bezier(0.4, 0, 0.2, 1) 0.05s both;
  }

  /* ===== SCROLL HINT ===== */
  .ysc-scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    right: 5rem;
    z-index: 10;
    opacity: 0.35;
  }

  @media (max-width: 768px) {
    .ysc-scroll-hint { display: none; }
  }

  .ysc-scroll-line {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, rgba(253, 245, 219, 0.6), transparent);
    animation: scroll-pulse 2.5s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { transform: translateY(0) scaleY(1); opacity: 0.6; }
    50% { transform: translateY(10px) scaleY(0.5); opacity: 1; }
  }
</style>

<script>
  const panelObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const panel = entry.target as HTMLElement;
          panel.classList.add('in-view');
          panel.querySelector('.ysc-inner')?.classList.add('is-visible');
          panelObserver.unobserve(panel);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('.ysc-panel').forEach((p) => panelObserver.observe(p));

  function updateParallax() {
    document.querySelectorAll<HTMLElement>('.ysc-panel').forEach((panel) => {
      const wrap = panel.querySelector<HTMLElement>('.ysc-bg-wrap');
      if (!wrap) return;
      const rect = panel.getBoundingClientRect();
      const center = rect.top + rect.height / 2;
      const progress = (window.innerHeight / 2 - center) / window.innerHeight;
      wrap.style.transform = `translateY(${progress * 70}px)`;
    });
  }

  window.addEventListener('scroll', updateParallax, { passive: true });
  window.addEventListener('resize', updateParallax, { passive: true });
  updateParallax();
</script>
