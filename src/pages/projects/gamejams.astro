---
import Layout from "@layouts/Layout.astro";
import "../../styles/global.css";

const games = [
  {
    name: "Bombs & Cats",
    description: "Second game jam after several months of development. A small horror and ambient game where you work on a conveyor belt and inspect boxes. Your task is to spot the difference and decide if there is a cat inside or a bomb. The project focuses on expandable and scalable systems.",
    image: "/bombsandcats.png",
    itchLink: "https://dambthirteen.itch.io/bombs-cats",
    youtubeId: "cmVdCQMgNXQ",
  },
  {
    name: "Snicer Micer",
    description: "My first ever game jam, where I gained my first experience working under a strict time limit. The game is inspired by a well known kitchen gadget and is about cutting vegetables as fast as possible under time pressure.",
    image: "/snicermicer.png",
    itchLink: "https://dambthirteen.itch.io/snicer-micer",
    youtubeId: "hj9Yoa_YYqI",
  },
];
---

<Layout pageTitle="Game Jams" pageDescription="Game jam projects by Thirteen Games - quick prototypes and creative experiments.">
  <article class="mx-auto max-w-3xl px-5 py-12">

    <div class="mb-12 text-center">
      <p class="mb-2 text-sm font-medium uppercase tracking-wider text-primary">Community Events</p>
      <h1 class="font-serif text-4xl font-bold text-white sm:text-5xl md:text-6xl">Game Jams</h1>
      <p class="mt-4 text-base text-neutral/70">A collection of games built during game jams.</p>
    </div>

    <div class="space-y-20">
      {games.map((game) => (
        <div class="rounded-lg border border-neutral/20 bg-[#1c232d]/50 p-6 sm:p-8">

          {/* Header */}
          <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="font-serif text-2xl font-bold text-white">{game.name}</h2>
            <a href={game.itchLink} target="_blank" class="btn-primary inline-flex items-center gap-2">
            Play on itch.io
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
          </div>

          {/* Description */}
          <p class="mb-8 text-base text-neutral">{game.description}</p>

          {/* Image */}
          <div class="mb-8 overflow-hidden rounded-lg">
            <img
              src={game.image}
              alt={game.name}
              class="h-auto w-full object-cover transition-transform duration-500 hover:scale-105"
            />
          </div>

          {/* YouTube Video */}
          {game.youtubeId && (
            <div>
              <h3 class="mb-4 font-serif text-lg font-bold text-white">Gameplay Video</h3>
              <div class="relative w-full overflow-hidden rounded-lg" style="padding-bottom: 56.25%;">
                <iframe
                  class="absolute inset-0 h-full w-full"
                  src={`https://www.youtube.com/embed/${game.youtubeId}`}
                  title={`${game.name} Gameplay`}
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          )}

        </div>
      ))}
    </div>

    {/* Back Link */}
    <div class="mt-12 border-t border-neutral/20 pt-8">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-neutral transition hover:text-white"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Back to Projects
      </a>
    </div>

  </article>
</Layout>