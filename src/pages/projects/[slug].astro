---
import { SITE_CONTENT } from "@config";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import "../../styles/global.css";

export function getStaticPaths() {
  return SITE_CONTENT.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { name, category, description, image, gallery, techStack, linkPreview, linkSource } = project;
---

<Layout pageTitle={name} pageDescription={project.info}>
  <article class="mx-auto max-w-3xl px-5 py-12">

    {/* Hero Banner */}
    <div class="reveal reveal-up relative -mx-5 mb-12 h-64 overflow-hidden rounded-lg sm:h-80 md:h-96">
      <Image
        class="h-full w-full object-cover object-center"
        src={image}
        alt={name}
        width="1200"
        height="600"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/70 to-black/10"></div>
      <div class="absolute bottom-0 left-0 px-8 pb-8">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-primary">{category}</p>
        <h1 class="font-serif text-4xl font-bold text-white drop-shadow-lg sm:text-5xl md:text-6xl">{name}</h1>
      </div>
    </div>

    {/* Links */}
    <div class="reveal reveal-up mb-12 flex gap-4" style="transition-delay: 100ms;">
      {linkPreview && (
        <a href={linkPreview} target="_blank" class="btn-primary">
          {linkPreview.includes('steam') ? 'Play on Steam' : 'Live Preview'}
        </a>
      )}
      {linkSource && (
        <a href={linkSource} target="_blank" class="btn-outline">
          {linkSource.includes('projectsunset') ? 'ProjectSunset UG' : linkSource.includes('assetstore') ? 'Unity Asset Store' : 'Source Code'}
        </a>
      )}
</div>

    {/* Description */}
    <div class="reveal reveal-left prose-section mb-16" style="transition-delay: 200ms;">
      <h2 class="mb-6 font-serif text-2xl font-bold text-white">About the Project</h2>
      <div class="text-base leading-relaxed text-neutral space-y-4" set:html={description} />
    </div>

    {/* YouTube Video */}
    {project.youtubeId && (
      <div class="reveal reveal-up mb-16" style="transition-delay: 300ms;">
        <h2 class="mb-6 font-serif text-2xl font-bold text-white">Video</h2>
        <div class="relative w-full overflow-hidden rounded-lg" style="padding-bottom: 56.25%;">
          <iframe
            class="absolute inset-0 h-full w-full"
            src={`https://www.youtube.com/embed/${project.youtubeId}`}
            title={`${name} Video`}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}

    {/* Tech Stack */}
    {techStack && techStack.length > 0 && (
      <div class="reveal reveal-right mb-16" style="transition-delay: 400ms;">
        <h2 class="mb-6 font-serif text-2xl font-bold text-white">Tech Stack</h2>
        <div class="flex flex-wrap gap-3">
          {techStack.map((tech, i) => (
            <span
              class="reveal-tag rounded-full border border-primary/40 bg-primary/10 px-5 py-2 text-sm text-primary"
              style={`transition-delay: ${450 + i * 80}ms;`}
            >
              {tech}
            </span>
          ))}
        </div>
      </div>
    )}

    {/* Gallery */}
    {gallery && gallery.length > 0 && (
      <div class="mb-16">
        <h2 class="reveal reveal-up mb-6 font-serif text-2xl font-bold text-white" style="transition-delay: 500ms;">Gallery</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {gallery.map((img, i) => (
            <div
              class="reveal reveal-scale overflow-hidden rounded-lg cursor-pointer gallery-thumb"
              style={`transition-delay: ${550 + i * 120}ms;`}
              data-src={img}
              data-alt={`${name} screenshot ${i + 1}`}
            >
              <Image
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                src={img}
                alt={`${name} screenshot ${i + 1}`}
                width="736"
                height="483"
              />
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Lightbox */}
    <div id="lightbox" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/95 backdrop-blur-sm">
      <button id="lightbox-close" class="absolute top-6 right-6 text-white/60 transition hover:text-white" aria-label="Close">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
      <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/40 transition hover:text-white" aria-label="Previous">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>
      <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/40 transition hover:text-white" aria-label="Next">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
      <img id="lightbox-img" class="max-h-[85vh] max-w-[90vw] rounded-lg object-contain shadow-2xl" src="" alt="" />
      <p id="lightbox-counter" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-sm text-white/40"></p>
    </div>

    {/* Back Link */}
    <div class="reveal reveal-up mt-12 border-t border-neutral/20 pt-8" style="transition-delay: 600ms;">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-neutral transition hover:text-white"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Back to Projects
      </a>
    </div>

  </article>
</Layout>

<script>
  const thumbs = document.querySelectorAll('.gallery-thumb');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  const lightboxCounter = document.getElementById('lightbox-counter');

  let currentIndex = 0;
  const images = Array.from(thumbs).map((t) => ({
    src: t.getAttribute('data-src') || '',
    alt: t.getAttribute('data-alt') || '',
  }));

  function openLightbox(index: number) {
    currentIndex = index;
    updateLightbox();
    lightbox?.classList.remove('hidden');
    lightbox?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function updateLightbox() {
    if (!lightboxImg || !lightboxCounter) return;
    lightboxImg.setAttribute('src', images[currentIndex].src);
    lightboxImg.setAttribute('alt', images[currentIndex].alt);
    lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`;

    if (lightboxPrev) lightboxPrev.style.display = images.length > 1 ? 'block' : 'none';
    if (lightboxNext) lightboxNext.style.display = images.length > 1 ? 'block' : 'none';
  }

  thumbs.forEach((thumb, i) => {
    thumb.addEventListener('click', () => openLightbox(i));
  });

  lightboxClose?.addEventListener('click', closeLightbox);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  lightboxPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    updateLightbox();
  });

  lightboxNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    currentIndex = (currentIndex + 1) % images.length;
    updateLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      updateLightbox();
    }
    if (e.key === 'ArrowRight') {
      currentIndex = (currentIndex + 1) % images.length;
      updateLightbox();
    }
  });
</script>

<style>
  .reveal {
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translate(0, 0) scale(1) !important;
  }

  .reveal-up {
    transform: translateY(40px);
  }

  .reveal-left {
    transform: translateX(-40px);
  }

  .reveal-right {
    transform: translateX(40px);
  }

  .reveal-scale {
    transform: scale(0.9);
  }

  .reveal-tag {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .reveal-tag.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal, .reveal-tag');

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  reveals.forEach((el) => revealObserver.observe(el));
</script>