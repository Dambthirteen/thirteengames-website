<Layout pageTitle="Impressum" pageDescription="Impressum von Thirteen Games — Angaben gemäß § 5 DDG.">
  <main class="mx-auto max-w-2xl px-5 py-20 text-neutral/80">
    <h1 class="font-serif text-4xl font-bold text-white mb-10">Impressum</h1>

    <section class="mb-8">
      <h2 class="text-xs font-semibold tracking-widest uppercase text-primary mb-4">Angaben gemäß § 5 DDG</h2>
      <p class="leading-relaxed">
        Dani Lipke<br />
        Franzstraße 72<br />
        50935 Köln
      </p>
    </section>

    <section class="mb-8">
      <h2 class="text-xs font-semibold tracking-widest uppercase text-primary mb-4">Kontakt</h2>
      <p class="leading-relaxed">
        Telefon: 0160 96433842<br />
        E-Mail: <a href="mailto:danijasonlipke@gmail.com" class="text-white hover:text-primary transition-colors">danijasonlipke@gmail.com</a>
      </p>
    </section>

    <section>
      <h2 class="text-xs font-semibold tracking-widest uppercase text-primary mb-4">Haftungsausschluss</h2>
      <p class="leading-relaxed text-sm text-neutral/60">
        Die Inhalte dieser Website wurden mit größtmöglicher Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit und Aktualität der Inhalte kann jedoch keine Gewähr übernommen werden.
      </p>
