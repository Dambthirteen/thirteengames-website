---
import { SITE_CONTENT } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import "../styles/global.css";
---

<Layout fullscreen>
  <Hero {...SITE_CONTENT.hero} />

  <!-- ===== YOU SHOULD CHOOSE ===== -->
  <section class="game-panel" id="you-should-choose">
    <div class="panel-bg-wrap">
      <img src="/Comingsoon-banner.png" alt="You Should Choose" class="panel-bg" />
    </div>
    <div class="panel-sweep-line"></div>
    <div class="panel-gradient"></div>
    <div class="panel-content">
      <div class="panel-inner">
        <span class="panel-eyebrow">01 — Game Development</span>
        <h2 class="panel-title">You Should Choose</h2>
        <p class="panel-tagline">
          An upcoming title about meaningful choices — currently in early
          development at Thirteen Games.
        </p>
        <div class="panel-actions">
          <a href="/projects/you-should-choose" class="btn-primary">Discover</a>
          <a href="https://store.steampowered.com" target="_blank" class="btn-outline">
            Wishlist on Steam
          </a>
        </div>
      </div>
    </div>
    <div class="panel-scroll-hint">
      <div class="scroll-line-panel"></div>
    </div>
  </section>

  <!-- ===== SIMPLE LIGHT FLICKER ===== -->
  <section class="game-panel panel-reverse" id="simple-light-flicker">
    <div class="panel-bg-wrap">
      <img src="/simple-light-flicker.png" alt="Simple Light Flicker" class="panel-bg" />
    </div>
    <div class="panel-sweep-line"></div>
    <div class="panel-gradient"></div>
    <div class="panel-content">
      <div class="panel-inner">
        <span class="panel-eyebrow">02 — Unity Asset</span>
        <h2 class="panel-title">Simple Light Flicker</h2>
        <p class="panel-tagline">
          A lightweight Unity tool that adds dynamic flickering to any light
          source — perfect for ambience and atmosphere.
        </p>
        <div class="panel-actions">
          <a href="/projects/simple-light-flicker" class="btn-primary">Discover</a>
          <a
            href="https://assetstore.unity.com/packages/slug/361974"
            target="_blank"
            class="btn-outline"
          >
            Asset Store
          </a>
        </div>
      </div>
    </div>
    <div class="panel-scroll-hint">
      <div class="scroll-line-panel"></div>
    </div>
  </section>

  <!-- ===== STAGED ===== -->
  <section class="game-panel" id="staged">
    <div class="panel-bg-wrap">
      <img src="/staged-keyart.png" alt="Staged" class="panel-bg" />
    </div>
    <div class="panel-sweep-line"></div>
    <div class="panel-gradient"></div>
    <div class="panel-content">
      <div class="panel-inner">
        <span class="panel-eyebrow">03 — Sound Design</span>
        <h2 class="panel-title">Staged</h2>
        <p class="panel-tagline">
          Sound design for the indie title Staged by ProjectSunset UG —
          atmospheric audio from ambience to interactive sound effects.
        </p>
        <div class="panel-actions">
          <a href="/projects/staged" class="btn-primary">Discover</a>
          <a
            href="https://store.steampowered.com/app/3534100/Staged/"
            target="_blank"
            class="btn-outline"
          >
            View on Steam
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ===== FULL-SCREEN GAME PANELS ===== */
  .game-panel {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  /* Parallax wrapper — moves via JS, no transition */
  .panel-bg-wrap {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .panel-bg {
    position: absolute;
    top: -10%;
    left: 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center;
    transition: transform 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .game-panel:hover .panel-bg {
    transform: scale(1.05);
  }

  /* Dual-axis gradient: bottom-to-top + left-to-transparent for text legibility */
  .panel-gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(14,13,12,0.82) 0%, rgba(14,13,12,0.45) 45%, transparent 75%),
      linear-gradient(to top, rgba(14,13,12,0.97) 0%, rgba(14,13,12,0.65) 28%, rgba(14,13,12,0.15) 65%, transparent 100%);
  }

  .panel-content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding: 0 5rem 7rem;
  }

  @media (max-width: 768px) {
    .panel-content {
      padding: 0 1.75rem 4.5rem;
    }
  }

  .panel-inner {
    position: relative;
    isolation: isolate;
    max-width: 740px;
    opacity: 0;
    transform: translateY(36px);
    transition: opacity 1.1s ease, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Soft dark backdrop behind text block */
  .panel-inner::before {
    content: '';
    position: absolute;
    left: -2.5rem;
    right: -1.5rem;
    top: -1.5rem;
    bottom: -1.5rem;
    background: radial-gradient(ellipse at 25% 60%, rgba(14,13,12,0.72) 30%, transparent 75%);
    z-index: -1;
    pointer-events: none;
  }

  .panel-inner.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Panel 2 slides in from the right */
  .panel-reverse .panel-inner {
    transform: translateX(48px);
  }

  .panel-reverse .panel-inner.is-visible {
    transform: translateX(0);
  }

  .panel-eyebrow {
    display: block;
    font-family: var(--font-display, 'Boldonse', serif);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c42218;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 14px rgba(0,0,0,0.9);
  }

  .panel-title {
    font-family: var(--font-display, 'Boldonse', serif);
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 400;
    color: #ffffff;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin-bottom: 1.75rem;
    text-shadow: 0 4px 28px rgba(0,0,0,0.95), 0 2px 8px rgba(0,0,0,0.8);
  }

  .panel-tagline {
    font-size: 1.2rem;
    line-height: 1.7;
    color: rgba(253, 245, 219, 0.72);
    max-width: 520px;
    margin-bottom: 3rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.9);
  }

  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* Red sweep line on panel entry */
  .panel-sweep-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, transparent 0%, #951810 20%, #ff3322 50%, #951810 80%, transparent 100%);
    z-index: 20;
    pointer-events: none;
    transform: translateX(-100%);
    opacity: 0;
  }

  @keyframes sweep {
    0%   { transform: translateX(-100%); opacity: 0; }
    8%   { opacity: 1; }
    80%  { opacity: 0.9; }
    100% { transform: translateX(100%); opacity: 0; }
  }

  .game-panel.in-view .panel-sweep-line {
    animation: sweep 1.3s cubic-bezier(0.4, 0, 0.2, 1) 0.05s both;
  }

  /* Scroll hint between panels */
  .panel-scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    right: 5rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.35;
  }

  @media (max-width: 768px) {
    .panel-scroll-hint {
      display: none;
    }
  }

  .scroll-line-panel {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, rgba(253, 245, 219, 0.6), transparent);
    animation: scroll-pulse-panel 2.5s ease-in-out infinite;
  }

  @keyframes scroll-pulse-panel {
    0%, 100% { transform: translateY(0) scaleY(1); opacity: 0.6; }
    50% { transform: translateY(10px) scaleY(0.5); opacity: 1; }
  }
</style>

<script>
  // === Panel entry: sweep-line + slide-in ===
  const panelObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const panel = entry.target as HTMLElement;
          panel.classList.add('in-view');
          panel.querySelector('.panel-inner')?.classList.add('is-visible');
          panelObserver.unobserve(panel);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('.game-panel').forEach((p) => panelObserver.observe(p));

  // === Per-panel background parallax ===
  function updatePanelParallax() {
    document.querySelectorAll<HTMLElement>('.game-panel').forEach((panel) => {
      const wrap = panel.querySelector<HTMLElement>('.panel-bg-wrap');
      if (!wrap) return;
      const rect = panel.getBoundingClientRect();
      const center = rect.top + rect.height / 2;
      const progress = (window.innerHeight / 2 - center) / window.innerHeight;
      wrap.style.transform = `translateY(${progress * 70}px)`;
    });
  }

  window.addEventListener('scroll', updatePanelParallax, { passive: true });
  window.addEventListener('resize', updatePanelParallax, { passive: true });
  updatePanelParallax();
</script>
