---
import { SITE_CONTENT } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import Projects from "@components/Projects.astro";
import Section from "@components/Section.astro";
import { Image } from "astro:assets";

import "../styles/global.css";

const otherProjects = SITE_CONTENT.projects.filter(p => p.slug !== 'you-should-choose');
const ysc = SITE_CONTENT.projects.find(p => p.slug === 'you-should-choose');
---

<Layout>
  <Hero {...SITE_CONTENT.hero} />

  <div class="fog-divider"></div>

  {/* ===== YOU SHOULD CHOOSE — Featured Section ===== */}
  {ysc && (
    <Section text="You should choose" href="featured">
      <div class="ysc-section">
        {/* Top: Main Banner */}
        <a href={`/projects/${ysc.slug}`} class="ysc-banner group relative block overflow-hidden rounded-lg border border-neutral/20">
          <Image
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            src={ysc.image}
            alt={ysc.name}
            width="1200"
            height="500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
          <div class="absolute bottom-0 left-0 px-8 pb-8">
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-primary">{ysc.category}</p>
            <h3 class="font-serif text-4xl font-bold text-white tracking-tight sm:text-5xl">{ysc.name}</h3>
          </div>
        </a>

        {/* Bottom: Info + Screenshots */}
        <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2">
          {/* Left: Text + Buttons */}
          <div class="flex flex-col justify-center">
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-primary">Coming Soon</p>
            <h4 class="mb-4 font-serif text-2xl font-bold text-white tracking-tight">A game about meaningful choices</h4>
            <p class="mb-8 text-base leading-relaxed text-neutral/60">
              You Should Choose is an upcoming title currently in early development at Thirteen Games.
              An innovative take on player decisions — where every choice shapes the experience.
              More details will be revealed soon.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/projects/you-should-choose" class="btn-primary">
                Learn More
              </a>
              <a href="https://store.steampowered.com" target="_blank" class="btn-outline">
                Wishlist on Steam
              </a>
            </div>
          </div>

          {/* Right: Screenshot Grid */}
          <div class="grid grid-cols-2 gap-3">
            <div class="ysc-thumb overflow-hidden rounded-lg border border-neutral/20">
              <img
                src="/placeholder-ysc-1.png"
                alt="You Should Choose Screenshot 1"
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-110"
              />
            </div>
            <div class="ysc-thumb overflow-hidden rounded-lg border border-neutral/20">
              <img
                src="/placeholder-ysc-2.png"
                alt="You Should Choose Screenshot 2"
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-110"
              />
            </div>
          </div>
        </div>
      </div>
    </Section>
  )}

  <div class="fog-divider"></div>

  {/* ===== OTHER PROJECTS ===== */}
  <Projects projects={otherProjects} />
</Layout>

<style>
  .ysc-banner {
    height: 320px;
    transform-style: preserve-3d;
    will-change: transform;
    background: linear-gradient(160deg, rgba(28, 35, 45, 0.9) 0%, rgba(14, 13, 12, 0.95) 100%);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(253, 245, 219, 0.05);
    transition: transform 0.2s ease, box-shadow 0.3s ease;
  }

  .ysc-banner::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 0.6rem;
    background: linear-gradient(var(--glow-angle, 0deg), #951810, transparent 40%, transparent 60%, #951810);
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: -1;
    animation: glow-spin 4s linear infinite;
  }

  .ysc-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    border: 1px solid rgba(149, 24, 16, 0.15);
    transition: border-color 0.3s ease;
    pointer-events: none;
  }

  .ysc-banner:hover::before { opacity: 1; }
  .ysc-banner:hover::after { border-color: rgba(149, 24, 16, 0.4); }
  .ysc-banner:hover {
    box-shadow: 0 20px 50px rgba(149, 24, 16, 0.25), 0 4px 20px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(253, 245, 219, 0.08);
  }

  @keyframes glow-spin {
    0% { --glow-angle: 0deg; }
    100% { --glow-angle: 360deg; }
  }

  @property --glow-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .ysc-spotlight {
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 10;
  }

  @media (min-width: 640px) {
    .ysc-banner { height: 400px; }
  }

  .ysc-thumb {
    aspect-ratio: 4 / 3;
    background: linear-gradient(160deg, rgba(28, 35, 45, 0.9), rgba(14, 13, 12, 0.95));
  }
</style>

<script>
  const banner = document.querySelector('.ysc-banner') as HTMLElement;
  if (banner) {
    const spotlight = document.createElement('div');
    spotlight.className = 'ysc-spotlight';
    banner.appendChild(spotlight);

    banner.addEventListener('mousemove', (e) => {
      const rect = banner.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const rotateX = ((y - centerY) / centerY) * -6;
      const rotateY = ((x - centerX) / centerX) * 6;
      const pullX = ((x - centerX) / centerX) * 5;
      const pullY = ((y - centerY) / centerY) * 5;

      banner.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateX(${pullX}px) translateY(${pullY}px) scale(1.02)`;

      spotlight.style.opacity = '1';
      spotlight.style.background = `radial-gradient(500px circle at ${x}px ${y}px, rgba(149, 24, 16, 0.15), transparent 60%)`;
    });

    banner.addEventListener('mouseleave', () => {
      banner.style.transform = 'rotateX(0deg) rotateY(0deg) translateX(0px) translateY(0px) scale(1)';
      spotlight.style.opacity = '0';
    });
  }
</script>