---
import { SITE_CONTENT } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import Projects from "@components/Projects.astro";
import Section from "@components/Section.astro";
import { Image } from "astro:assets";

import "../styles/global.css";

const otherProjects = SITE_CONTENT.projects.filter(p => p.slug !== 'you-should-choose');
const ysc = SITE_CONTENT.projects.find(p => p.slug === 'you-should-choose');
---

<Layout>
  <Hero {...SITE_CONTENT.hero} />

  {/* ===== YOU SHOULD CHOOSE — Featured Section ===== */}
  {ysc && (
    <Section text="Featured Project" href="featured">
      <div class="ysc-section">
        {/* Top: Main Banner */}
        <a href={`/projects/${ysc.slug}`} class="ysc-banner group relative block overflow-hidden rounded-lg border border-neutral/20">
          <Image
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            src={ysc.image}
            alt={ysc.name}
            width="1200"
            height="500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
          <div class="absolute bottom-0 left-0 px-8 pb-8">
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-primary">{ysc.category}</p>
            <h3 class="font-serif text-4xl font-bold text-white tracking-tight sm:text-5xl">{ysc.name}</h3>
          </div>
        </a>

        {/* Bottom: Info + Screenshots */}
        <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2">
          {/* Left: Text + Buttons */}
          <div class="flex flex-col justify-center">
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-primary">Coming Soon</p>
            <h4 class="mb-4 font-serif text-2xl font-bold text-white tracking-tight">A game about meaningful choices</h4>
            <p class="mb-8 text-base leading-relaxed text-neutral/60">
              You Should Choose is an upcoming title currently in early development at Thirteen Games.
              An innovative take on player decisions — where every choice shapes the experience.
              More details will be revealed soon.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/projects/you-should-choose" class="btn-primary">
                Learn More
              </a>
              <a href="https://store.steampowered.com" target="_blank" class="btn-outline">
                Wishlist on Steam
              </a>
            </div>
          </div>

          {/* Right: Screenshot Grid */}
          <div class="grid grid-cols-2 gap-3">
            <div class="ysc-thumb overflow-hidden rounded-lg border border-neutral/20">
              <img
                src="/placeholder-ysc-1.png"
                alt="You Should Choose Screenshot 1"
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-110"
              />
            </div>
            <div class="ysc-thumb overflow-hidden rounded-lg border border-neutral/20">
              <img
                src="/placeholder-ysc-2.png"
                alt="You Should Choose Screenshot 2"
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-110"
              />
            </div>
          </div>
        </div>
      </div>
    </Section>
  )}

  {/* ===== OTHER PROJECTS ===== */}
  <Projects projects={otherProjects} />
</Layout>

<style>
  .ysc-banner {
    height: 320px;
  }

  @media (min-width: 640px) {
    .ysc-banner {
      height: 400px;
    }
  }

  .ysc-thumb {
    aspect-ratio: 4 / 3;
    background: linear-gradient(160deg, rgba(28, 35, 45, 0.9), rgba(14, 13, 12, 0.95));
  }
</style>