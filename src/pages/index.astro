---
import { SITE_CONTENT } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import "../styles/global.css";
---

<Layout fullscreen>
  <Hero {...SITE_CONTENT.hero} />

  <!-- ===== YOU SHOULD CHOOSE ===== -->
  <section class="game-panel" id="you-should-choose">
    <img src="/Comingsoon-banner.png" alt="You Should Choose" class="panel-bg" />
    <div class="panel-gradient"></div>
    <div class="panel-content">
      <div class="panel-inner">
        <span class="panel-eyebrow">01 — Game Development</span>
        <h2 class="panel-title">You Should Choose</h2>
        <p class="panel-tagline">
          An upcoming title about meaningful choices — currently in early
          development at Thirteen Games.
        </p>
        <div class="panel-actions">
          <a href="/projects/you-should-choose" class="btn-primary">Discover</a>
          <a href="https://store.steampowered.com" target="_blank" class="btn-outline">
            Wishlist on Steam
          </a>
        </div>
      </div>
    </div>
    <div class="panel-scroll-hint">
      <div class="scroll-line-panel"></div>
    </div>
  </section>

  <!-- ===== SIMPLE LIGHT FLICKER ===== -->
  <section class="game-panel" id="simple-light-flicker">
    <img src="/simple-light-flicker.png" alt="Simple Light Flicker" class="panel-bg" />
    <div class="panel-gradient"></div>
    <div class="panel-content">
      <div class="panel-inner">
        <span class="panel-eyebrow">02 — Unity Asset</span>
        <h2 class="panel-title">Simple Light Flicker</h2>
        <p class="panel-tagline">
          A lightweight Unity tool that adds dynamic flickering to any light
          source — perfect for ambience and atmosphere.
        </p>
        <div class="panel-actions">
          <a href="/projects/simple-light-flicker" class="btn-primary">Discover</a>
          <a
            href="https://assetstore.unity.com/packages/slug/361974"
            target="_blank"
            class="btn-outline"
          >
            Asset Store
          </a>
        </div>
      </div>
    </div>
    <div class="panel-scroll-hint">
      <div class="scroll-line-panel"></div>
    </div>
  </section>

  <!-- ===== STAGED ===== -->
  <section class="game-panel" id="staged">
    <img src="/staged-keyart.png" alt="Staged" class="panel-bg" />
    <div class="panel-gradient"></div>
    <div class="panel-content">
      <div class="panel-inner">
        <span class="panel-eyebrow">03 — Sound Design</span>
        <h2 class="panel-title">Staged</h2>
        <p class="panel-tagline">
          Sound design for the indie title Staged by ProjectSunset UG —
          atmospheric audio from ambience to interactive sound effects.
        </p>
        <div class="panel-actions">
          <a href="/projects/staged" class="btn-primary">Discover</a>
          <a
            href="https://store.steampowered.com/app/3534100/Staged/"
            target="_blank"
            class="btn-outline"
          >
            View on Steam
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ===== FULL-SCREEN GAME PANELS ===== */
  .game-panel {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .panel-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }

  .game-panel:hover .panel-bg {
    transform: scale(1.04);
  }

  .panel-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(14, 13, 12, 0.96) 0%,
      rgba(14, 13, 12, 0.6) 30%,
      rgba(14, 13, 12, 0.2) 60%,
      rgba(14, 13, 12, 0.05) 100%
    );
  }

  .panel-content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding: 0 5rem 5.5rem;
  }

  @media (max-width: 768px) {
    .panel-content {
      padding: 0 1.75rem 3.5rem;
    }
  }

  .panel-inner {
    max-width: 660px;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 1s ease, transform 1s ease;
  }

  .panel-inner.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .panel-eyebrow {
    display: block;
    font-family: var(--font-display, 'Boldonse', serif);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #951810;
    margin-bottom: 1.25rem;
  }

  .panel-title {
    font-family: var(--font-display, 'Boldonse', serif);
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 400;
    color: #ffffff;
    line-height: 1.0;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .panel-tagline {
    font-size: 1.25rem;
    line-height: 1.65;
    color: rgba(253, 245, 219, 0.65);
    max-width: 540px;
    margin-bottom: 2.75rem;
  }

  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
  }

  /* Scroll hint between panels */
  .panel-scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    right: 5rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.35;
  }

  @media (max-width: 768px) {
    .panel-scroll-hint {
      display: none;
    }
  }

  .scroll-line-panel {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, rgba(253, 245, 219, 0.6), transparent);
    animation: scroll-pulse-panel 2.5s ease-in-out infinite;
  }

  @keyframes scroll-pulse-panel {
    0%, 100% { transform: translateY(0) scaleY(1); opacity: 0.6; }
    50% { transform: translateY(10px) scaleY(0.5); opacity: 1; }
  }
</style>

<script>
  const panels = document.querySelectorAll('.panel-inner');

  const panelObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          panelObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  panels.forEach((p) => panelObserver.observe(p));
</script>
